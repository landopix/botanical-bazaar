# --- Next.js Base Server Setup ---
PORT=3000

# --- Builder.io Visual Content Platform Keys ---
NEXT_PUBLIC_BUILDER_API_KEY=mock-key

# --- Sanity.io Headless Content Management ---
SANITY_PROJECT_ID=mock-project-id
SANITY_DATASET=production
SANITY_AUTH_TOKEN=mock-sanity-write-token

# --- Stripe Payments Gateway Secrets ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock
STRIPE_SECRET_KEY=mock-stripe-secret

# --- Anti-Spam Protection ---
# Turnstile Site Key (Client-side) and Secret Key (Server-side) from Cloudflare Dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=mock-turnstile-site-key
TURNSTILE_SECRET_KEY=mock-turnstile-secret

# --- Form secure email delivery ---
# SendGrid API key and Resend API key placeholders
SENDGRID_API_KEY=mock-sendgrid-key
RESEND_API_KEY=mock-resend-key
