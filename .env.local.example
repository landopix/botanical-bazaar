# -----------------------------------------------------------------------------
# The Botanical Bazaar LLC - Environment Configuration Options
# -----------------------------------------------------------------------------

# --- Next.js Base Server Setup ---
PORT=3000

# --- Shopify Storefront API Credentials ---
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=the-botanical-bazaar.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=136153c263edc39e34b8b67afbef3a72

# --- Builder.io Visual Content Platform Keys ---
# Retrieve this API key from your Builder.io space settings dashboard.
NEXT_PUBLIC_BUILDER_API_KEY=mock-key

# --- Sanity.io Headless Content Management ---
# Retrieve your Project ID, Dataset name, and Write Access Token from Sanity Manage (sanity.io/manage)
SANITY_PROJECT_ID=mock-project-id
SANITY_DATASET=production
SANITY_AUTH_TOKEN=mock-sanity-write-token
